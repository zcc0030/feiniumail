#!/bin/bash
# 卸载前：停止服务
set -u

PKGVAR="${TRIM_PKGVAR:-/var/apps/fnmail/var}"
PIDFILE="$PKGVAR/fnmail.pid"

pid=""
if [ -f "$PIDFILE" ]; then
    pid="$(cat "$PIDFILE" 2>/dev/null)"
fi
if [ -z "$pid" ] || ! kill -0 "$pid" 2>/dev/null; then
    pid="$(pgrep -f -- "main\.py .*--data-dir $PKGVAR" 2>/dev/null | head -n 1)"
fi

if [ -n "$pid" ]; then
    kill "$pid" 2>/dev/null
    i=0
    while [ "$i" -lt 30 ]; do
        kill -0 "$pid" 2>/dev/null || break
        sleep 0.3
        i=$((i + 1))
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
fi
rm -f "$PIDFILE"

exit 0
